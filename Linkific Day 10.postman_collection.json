  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Validate that the login response returns a successful 200 status code\r",
                  "pm.test(\"Login status code is 200 OK\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// 2. Extract the access token dynamically and save it directly to your environment variable profile\r",
                  "var responseData = pm.response.json();\r",
                  "if (responseData.access_token) {\r",
                  "    pm.environment.set(\"token\", responseData.access_token);\r",
                  "    console.log(\"Token successfully captured and chained: \" + responseData.access_token);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\": \"developer_kanis\",\r\n    \"password\": \"super_secure_password_2026\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
